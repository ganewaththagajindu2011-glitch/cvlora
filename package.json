{
  "name": "cvlora",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @cvlora/web --filter @cvlora/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @cvlora/api db:generate",
    "db:migrate": "pnpm --filter @cvlora/api db:migrate",
    "prepare": "husky",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:budgets": "node scripts/check-budgets.mjs",
    "test:lighthouse": "lhci autorun",
    "test:load": "autocannon -c 10 -d 10 http://127.0.0.1:4000/health"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@size-limit/file": "14.2.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autocannon": "8.0.0",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "size-limit": "14.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yaml,yml}": "prettier --write"
  }
}
